def get_top_daily_active(group_id=None, limit=5):
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()

    today = datetime.now().strftime("%Y-%m-%d")

    if group_id is not None:
        cursor.execute("""
            SELECT
                user_id,
                full_name,
                username,
                SUM(message_count) AS total
            FROM group_activity
            WHERE group_id = ?
              AND created_at = ?
            GROUP BY user_id
            ORDER BY total DESC
            LIMIT ?
        """, (group_id, today, limit))
    else:
        cursor.execute("""
            SELECT
                user_id,
                full_name,
                username,
                SUM(message_count) AS total
            FROM group_activity
            WHERE created_at = ?
            GROUP BY user_id
            ORDER BY total DESC
            LIMIT ?
        """, (today, limit))

    rows = cursor.fetchall()
    conn.close()
    return rows


