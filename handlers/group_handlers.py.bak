from html import escape

from aiogram import Router, F, types
from aiogram.filters import Command

from database import (
    log_group_message,
    get_top_daily_active,
    get_top_monthly_active,
    get_group_admin_activity
)

router = Router()


def display_name(full_name, username):
    if username:
        return f"@{escape(username)}"

    return escape(full_name or "Noma'lum")


def medal(index):
    if index == 1:
        return "🥇"
    if index == 2:
        return "🥈"
    if index == 3:
        return "🥉"

    return f"{index}."


async def get_admin_ids(bot, chat_id):
    admins = await bot.get_chat_administrators(chat_id)

    return [
        admin.user.id
        for admin in admins
        if not admin.user.is_bot
    ]


def activity_keyboard():
    return types.InlineKeyboardMarkup(
        inline_keyboard=[
            [
                types.InlineKeyboardButton(
                    text="👑 Adminlar aktivligi",
                    callback_data="group_admin_activity"
                )
            ],
            [
                types.InlineKeyboardButton(
                    text="🔄 Yangilash",
                    callback_data="group_activity_refresh"
                )
            ]
        ]
    )


def build_activity_text(daily, monthly):
    text = "<b>🏆 GURUH FAOLLIGI</b>\n\n"

    text += "<b>📅 Bugungi TOP 5 — oddiy odamlar:</b>\n"

    if daily:
        for i, row in enumerate(daily, 1):
            user_id, full_name, username, count = row

            name = display_name(
                full_name,
                username
            )

            text += (
                f"{medal(i)} <b>{name}</b> — "
                f"{count} ta xabar\n"
            )
    else:
        text += "Hali aktivlik yo'q.\n"

    text += "\n"

    text += "<b>📆 Oylik TOP 5 — oddiy odamlar:</b>\n"

    if monthly:
        for i, row in enumerate(monthly, 1):
            user_id, full_name, username, count = row

            name = display_name(
                full_name,
                username
            )

            text += (
                f"{medal(i)} <b>{name}</b> — "
                f"{count} ta xabar\n"
            )
    else:
        text += "Hali oylik aktivlik yo'q.\n"

    return text


# ============================================================
# 📊 /AKTIV
# ============================================================

@router.message(
    Command("aktiv"),
    F.chat.type.in_({"group", "supergroup"})
)
async def show_group_activity(
    message: types.Message
):
    chat_id = message.chat.id

    # Adminlarni topamiz.
    admin_ids = await get_admin_ids(
        message.bot,
        chat_id
    )

    # /aktiv yozgan odamni BU YERDA alohida sanamaymiz.
    # Chunki pastdagi umumiy tracker uni allaqachon hisoblaydi.
    daily = get_top_daily_active(
        group_id=chat_id,
        limit=5,
        exclude_user_ids=admin_ids
    )

    monthly = get_top_monthly_active(
        group_id=chat_id,
        limit=5,
        exclude_user_ids=admin_ids
    )

    text = build_activity_text(
        daily,
        monthly
    )

    await message.answer(
        text,
        reply_markup=activity_keyboard(),
        parse_mode="HTML"
    )


# ============================================================
# 👑 ADMINLAR AKTIVLIGI
# ============================================================

@router.callback_query(
    F.data == "group_admin_activity"
)
async def show_group_admin_activity(
    callback: types.CallbackQuery
):
    if not callback.message:
        await callback.answer()
        return

    if callback.message.chat.type not in {
        "group",
        "supergroup"
    }:
        await callback.answer(
            "Bu tugma faqat guruhda ishlaydi.",
            show_alert=True
        )
        return

    chat_id = callback.message.chat.id

    admin_ids = await get_admin_ids(
        callback.bot,
        chat_id
    )

    daily = get_group_admin_activity(
        chat_id,
        admin_ids,
        monthly=False
    )

    monthly = get_group_admin_activity(
        chat_id,
        admin_ids,
        monthly=True
    )

    text = "<b>👑 GURUHDAGI ADMINLAR AKTIVLIGI</b>\n\n"

    text += "<b>📅 Bugungi:</b>\n"

    if daily:
        for i, row in enumerate(daily, 1):
            user_id, full_name, username, count = row

            name = display_name(
                full_name,
                username
            )

            text += (
                f"{i}. <b>{name}</b> — "
                f"{count} ta xabar\n"
            )
    else:
        text += "Adminlar topilmadi.\n"

    text += "\n<b>📆 Oylik:</b>\n"

    if monthly:
        for i, row in enumerate(monthly, 1):
            user_id, full_name, username, count = row

            name = display_name(
                full_name,
                username
            )

            text += (
                f"{i}. <b>{name}</b> — "
                f"{count} ta xabar\n"
            )
    else:
        text += "Adminlar topilmadi.\n"

    keyboard = types.InlineKeyboardMarkup(
        inline_keyboard=[
            [
                types.InlineKeyboardButton(
                    text="⬅️ Aktivlikka qaytish",
                    callback_data="group_activity_refresh"
                )
            ]
        ]
    )

    await callback.message.edit_text(
        text,
        reply_markup=keyboard,
        parse_mode="HTML"
    )

    await callback.answer()


# ============================================================
# 🔄 YANGILASH
# ============================================================

@router.callback_query(
    F.data == "group_activity_refresh"
)
async def refresh_group_activity(
    callback: types.CallbackQuery
):
    if not callback.message:
        await callback.answer()
        return

    if callback.message.chat.type not in {
        "group",
        "supergroup"
    }:
        await callback.answer(
            "Bu tugma faqat guruhda ishlaydi.",
            show_alert=True
        )
        return

    chat_id = callback.message.chat.id

    admin_ids = await get_admin_ids(
        callback.bot,
        chat_id
    )

    daily = get_top_daily_active(
        group_id=chat_id,
        limit=5,
        exclude_user_ids=admin_ids
    )

    monthly = get_top_monthly_active(
        group_id=chat_id,
        limit=5,
        exclude_user_ids=admin_ids
    )

    text = build_activity_text(
        daily,
        monthly
    )

    await callback.message.edit_text(
        text,
        reply_markup=activity_keyboard(),
        parse_mode="HTML"
    )

    await callback.answer(
        "🔄 Yangilandi"
    )


# ============================================================
# 🔨 !unadmin @username
# ============================================================

@router.message(
    F.chat.type.in_({"group", "supergroup"}),
    F.text.startswith("!unadmin")
)
async def unadmin_command(message: types.Message):
    if not message.from_user:
        return

    # Buyruq bergan odam admin ekanini tekshiramiz
    try:
        caller = await message.bot.get_chat_member(
            message.chat.id,
            message.from_user.id
        )
    except Exception as e:
        print(f"⚠️ Adminni tekshirishda xato: {e}")
        return

    if caller.status not in {"administrator", "creator"}:
        await message.reply(
            "⛔️ Bu buyruqni faqat guruh adminlari ishlata oladi."
        )
        return

    parts = message.text.split()

    if len(parts) != 2 or not parts[1].startswith("@"):
        await message.reply(
            "❌ Foydalanish:\n"
            "<code>!unadmin @username</code>",
            parse_mode="HTML"
        )
        return

    username = parts[1][1:].lower()

    # Guruh adminlari orasidan username orqali qidiramiz
    try:
        admins = await message.bot.get_chat_administrators(message.chat.id)
    except Exception as e:
        print(f"⚠️ Adminlar ro'yxatini olishda xato: {e}")
        await message.reply(
            "❌ Guruh adminlarini aniqlab bo'lmadi."
        )
        return

    target = None

    for admin in admins:
        user = admin.user

        if user.username and user.username.lower() == username:
            target = admin
            break

    if target is None:
        await message.reply(
            f"❌ <b>@{username}</b> guruh adminlari orasidan topilmadi.",
            parse_mode="HTML"
        )
        return

    # Guruh egasini (creator) demote qilib bo'lmaydi
    if target.status == "creator":
        await message.reply(
            "⛔️ Guruh egasini adminlikdan olib bo'lmaydi."
        )
        return

    # Bot o'z huquqini tekshiradi
    try:
        bot_member = await message.bot.get_chat_member(
            message.chat.id,
            message.bot.id
        )
    except Exception as e:
        print(f"⚠️ Bot huquqini tekshirishda xato: {e}")
        return

    if bot_member.status != "administrator":
        await message.reply(
            "❌ Bot guruhda administrator emas."
        )
        return

    if not getattr(bot_member, "can_promote_members", False):
        await message.reply(
            "❌ Botda boshqa adminlarni boshqarish huquqi yo'q."
        )
        return

    # Adminlik huquqlarini olib tashlaymiz
    try:
        await message.bot.promote_chat_member(
            chat_id=message.chat.id,
            user_id=target.user.id,
            is_anonymous=False,
            can_manage_chat=False,
            can_delete_messages=False,
            can_manage_video_chats=False,
            can_restrict_members=False,
            can_promote_members=False,
            can_change_info=False,
            can_invite_users=False,
            can_pin_messages=False,
            can_manage_topics=False
        )

        await message.reply(
            f"✅ <b>@{username}</b> adminlikdan olindi.",
            parse_mode="HTML"
        )

    except Exception as e:
        print(f"⚠️ Adminlikni olishda xato: {e}")
        await message.reply(
            "❌ Adminlikni olib bo'lmadi. "
            "Botda yetarli huquq borligini tekshiring."
        )


# ============================================================
# 💬 GURUHDAGI XABARLARNI HISOBLASH
# ============================================================

@router.message(
    F.chat.type.in_({
        "group",
        "supergroup"
    })
)
async def track_group_messages(
    message: types.Message
):
    if not message.from_user:
        return

    if message.from_user.is_bot:
        return

    # /aktiv buyrug'ini bu yerda alohida
    # qayta sanamaymiz.
    if (
        message.text
        and message.text.split()[0].lower()
        in {
            "/aktiv",
            "/aktiv@"
        }
    ):
        return

    log_group_message(
        user_id=message.from_user.id,
        group_id=message.chat.id,
        full_name=message.from_user.full_name,
        username=message.from_user.username or ""
    )

# ============================================================
# 🚫 ADMIN 15 TA ODAMNI KETMA-KET CHIQARISH NAZORATI
# 🤖 BOTLAR HISOBLANMAYDI
# ============================================================

_admin_kick_counts = {}


@router.chat_member()
async def track_admin_kicks(event: types.ChatMemberUpdated):
    # Faqat guruh/superguruh
    if event.chat.type not in {"group", "supergroup"}:
        return

    # Faqat haqiqiy foydalanuvchi chiqarilganda
    if not event.old_chat_member or not event.new_chat_member:
        return

    # Faqat LEFT/KICKED holatini tekshiramiz
    old_status = event.old_chat_member.status
    new_status = event.new_chat_member.status

    if new_status not in {"left", "kicked"}:
        return

    # Oldin ham chiqarilgan holatda bo'lsa — qayta hisoblamaymiz
    if old_status in {"left", "kicked"}:
        return

    # Chiqarilgan odam BOT bo'lsa — hisoblanmaydi
    target_user = event.new_chat_member.user

    if target_user.is_bot:
        return

    # Kim bajarganini aniqlaymiz
    actor = event.from_user

    if not actor:
        return

    # Bot bajargan harakat — hisoblanmaydi
    if actor.is_bot:
        return

    # Faqat admin harakati hisoblanadi
    try:
        actor_member = await event.bot.get_chat_member(
            event.chat.id,
            actor.id
        )
    except Exception as e:
        print(f"⚠️ Admin statusini tekshirishda xato: {e}")
        return

    if actor_member.status not in {"administrator", "creator"}:
        return

    # Guruh + admin bo'yicha alohida hisob
    key = (event.chat.id, actor.id)

    _admin_kick_counts[key] = _admin_kick_counts.get(key, 0) + 1

    count = _admin_kick_counts[key]

    print(
        f"🚫 {actor.id} -> {target_user.id} chiqarildi "
        f"({count}/15)"
    )

    # 15 taga yetganda
    if count >= 15:
        _admin_kick_counts[key] = 0

        try:
            # Bot o'zining huquqini tekshiradi
            bot_member = await event.bot.get_chat_member(
                event.chat.id,
                event.bot.id
            )

            if (
                bot_member.status == "administrator"
                and getattr(bot_member, "can_promote_members", False)
            ):
                await event.bot.promote_chat_member(
                    chat_id=event.chat.id,
                    user_id=actor.id,
                    is_anonymous=False,
                    can_manage_chat=False,
                    can_delete_messages=False,
                    can_manage_video_chats=False,
                    can_restrict_members=False,
                    can_promote_members=False,
                    can_change_info=False,
                    can_invite_users=False,
                    can_pin_messages=False
                )

                await event.bot.send_message(
                    event.chat.id,
                    f"⚠️ <b>Adminlik olib tashlandi.</b>\n\n"
                    f"👤 {display_name(actor.full_name, actor.username)}\n"
                    f"🆔 <code>{actor.id}</code>\n"
                    f"📊 Ketma-ket chiqarilganlar: <b>15</b>",
                    parse_mode="HTML"
                )

        except Exception as e:
            print(f"⚠️ Adminlikni olib tashlashda xato: {e}")

