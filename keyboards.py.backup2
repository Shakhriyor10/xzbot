BTN_ADMIN_6 = "📊 𝗘𝗻𝗴 𝗞𝗼'𝗽 𝗸𝗲𝗹𝗴𝗮𝗻 𝗚𝘂𝗿𝘂𝗵 𝗿𝗲𝗸𝗹𝗮𝗺𝗮𝘀𝗶"
BTN_ADMIN_7 = "📱 𝗔𝗰𝗰𝗼𝘂𝗻𝘁 𝗨𝗹𝗮𝘀𝗵 𝗥𝗲𝗸𝗹𝗮𝗺𝗮 𝗨𝗰𝗵𝘂𝗻"
BTN_ADMIN_8 = "🏆 𝗚𝘂𝗿𝘂𝗵𝗱𝗮 𝗧𝗼𝗽 𝟱 𝗔𝗸𝘁𝗶𝘃 𝗢𝗱𝗮𝗺𝗹𝗮𝗿"

BTN_OWNER_9 = "⚙️ 𝗔𝗱𝗺𝗶𝗻𝗹𝗮𝗿𝗻𝗶 𝗕𝗼𝘀𝗵𝗾𝗮𝗿𝗶𝘀𝗵"
BTN_BACK = "⬅️ 𝗢𝗿𝗾𝗮𝗴𝗮"

back_keyboard = ReplyKeyboardMarkup(
    keyboard=[[KeyboardButton(text=BTN_BACK)]],
    resize_keyboard=True
)

def get_main_menu(user_id: int, admins_list: list) -> InlineKeyboardMarkup:
    buttons = [
        [
            InlineKeyboardButton(
                text=BTN_USER_1,
                callback_data="menu_ad"
            )
        ],
        [
            InlineKeyboardButton(
                text=BTN_USER_2,
                callback_data="menu_roles"
            ),
            InlineKeyboardButton(
                text=BTN_USER_3,
                callback_data="menu_complaint"
            )
        ],
        [
            InlineKeyboardButton(
                text=BTN_ADMIN_4,
                callback_data="menu_groups"
            ),
            InlineKeyboardButton(
                text=BTN_ADMIN_5,
                callback_data="menu_today"
            )
        ],
        [
            InlineKeyboardButton(
                text=BTN_ADMIN_6,
                callback_data="menu_stats"
            )
        ],
        [
            InlineKeyboardButton(
                text=BTN_ADMIN_7,
                callback_data="menu_account"
            ),
            InlineKeyboardButton(
                text=BTN_ADMIN_8,
                callback_data="menu_top"
            )
        ]
    ]

    if user_id == OWNER_ID:
        buttons.append([
            InlineKeyboardButton(
                text=BTN_OWNER_9,
                callback_data="menu_admin"
            )
        ])

    return InlineKeyboardMarkup(inline_keyboard=buttons)


